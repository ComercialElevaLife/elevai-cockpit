{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/lp.html", "/lp"] },
  "globalHeaders": { "cache-control": "no-store, must-revalidate" },
  "platform": { "apiRuntime": "node:18" },
  "routes": [
    { "route": "/lp", "rewrite": "/lp.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/lp.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/lead-publico", "methods": ["POST"], "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/notificacoes", "methods": ["POST", "PATCH"], "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/contratos-sync", "methods": ["GET"], "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" }
  }
}
